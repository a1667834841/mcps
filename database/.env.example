# Database Configuration Template
# Copy this file to .env and update with your settings

# =============================================================================
# Database Type Selection
# =============================================================================
# Set DB_TYPE to 'sqlserver', 'mysql', or 'oceanbase' to select the database provider
# Default: sqlserver
DB_TYPE=sqlserver

# =============================================================================
# Unified Database Configuration
# =============================================================================
# These settings apply to all database types
# Default port is auto-selected based on DB_TYPE:
#   - sqlserver: 1433
#   - mysql: 3306
#   - oceanbase: 2881

# Server host
DB_HOST=localhost

# Server port (optional, auto-defaults based on DB_TYPE)
# DB_PORT=1433

# Database user
DB_USER=root

# Database password
DB_PASSWORD=

# Default database
DB_DATABASE=master

# Character set for MySQL/OceanBase (default: utf8mb4)
DB_CHARSET=utf8mb4

# Request timeout in milliseconds (default: 30000)
# DB_REQUEST_TIMEOUT=30000

# =============================================================================
# SQL Server Specific Configuration
# =============================================================================
# These settings override the unified configuration for SQL Server only

# Enable encryption (default: true)
# SQLSERVER_ENCRYPT=true

# Trust server certificate (default: true)
# SQLSERVER_TRUST_SERVER_CERTIFICATE=true

# Override settings (optional):
# SQLSERVER_HOST=localhost
# SQLSERVER_PORT=1433
# SQLSERVER_USER=sa
# SQLSERVER_PASSWORD=YourPassword123
# SQLSERVER_DATABASE=MyDatabase

# =============================================================================
# MySQL Specific Configuration
# =============================================================================
# These settings override the unified configuration for MySQL only

# Character set (default: utf8mb4)
# MYSQL_CHARSET=utf8mb4

# Override settings (optional):
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=YourPassword123
# MYSQL_DATABASE=mydb

# =============================================================================
# OceanBase Specific Configuration
# =============================================================================
# These settings override the unified configuration for OceanBase only

# Character set (default: utf8mb4)
# OCEANBASE_CHARSET=utf8mb4

# Override settings (optional):
# OCEANBASE_HOST=localhost
# OCEANBASE_PORT=2881
# OCEANBASE_USER=root@sys
# OCEANBASE_PASSWORD=YourPassword123
# OCEANBASE_DATABASE=mydb
